EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
RECEIVER_EMAIL=receiver@example.com

# Default: daily at 6:00 PM.
CRON_SCHEDULE=0 18 * * *

# Default: India time. Change this if you deploy for another timezone.
TIMEZONE=Asia/Kolkata

# Optional: true = fetch a random quote from the API, false = use local messages.
USE_QUOTES_API=false

# Optional: true = send one test email immediately when the app starts.
SEND_ON_STARTUP=false
