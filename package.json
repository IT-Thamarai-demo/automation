{
  "name": "daily-email-automation",
  "version": "1.0.0",
  "description": "Daily 6 PM email automation using Node.js, node-cron, Nodemailer, and Gmail SMTP.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "send:now": "node -e \"require('dotenv').config(); require('./mailer').sendDailyEmail().catch(() => process.exit(1));\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7"
  }
}
